  {0x1E, 0x05, 0x1E}, {0x1F, 0x15, 0x0A}, {0x0E, 0x11, 0x11}, {0x1F, 0x11, 0x0E}, // A-D
  {0x1F, 0x15, 0x11}, {0x1F, 0x05, 0x01}, {0x0E, 0x15, 0x1D}, {0x1F, 0x04, 0x1F}, // E-H
  {0x11, 0x1F, 0x11}, {0x08, 0x10, 0x0F}, {0x1F, 0x04, 0x1B}, {0x1F, 0x10, 0x10}, // I-L
  {0x1F, 0x02, 0x1F}, {0x1F, 0x02, 0x1C}, {0x0E, 0x11, 0x0E}, {0x1F, 0x05, 0x02}, // M-P
  {0x0E, 0x15, 0x1F}, {0x1F, 0x05, 0x1A}, {0x12, 0x15, 0x09}, {0x01, 0x1F, 0x01}, // Q-T
  {0x0F, 0x10, 0x0F}, {0x07, 0x18, 0x07}, {0x1F, 0x08, 0x1F}, {0x1B, 0x04, 0x1B}, // U-X
  {0x03, 0x1C, 0x03}, {0x19, 0x15, 0x13},                                         // Y, Z
  {0x1F, 0x11, 0x1F}, {0x00, 0x1F, 0x00}, {0x1D, 0x15, 0x17}, {0x15, 0x15, 0x1F}, // 0-3
  {0x07, 0x04, 0x1F}, {0x17, 0x15, 0x1D}, {0x1F, 0x15, 0x1D}, {0x01, 0x01, 0x1F}, // 4-7
  {0x1F, 0x15, 0x1F}, {0x17, 0x15, 0x1F},                                         // 8, 9
  {0x00, 0x00, 0x00}, {0x00, 0x0A, 0x00}                                          // Space, Colon
};

