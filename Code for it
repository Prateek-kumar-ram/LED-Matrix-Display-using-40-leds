// --- Helper Functions ---
void spawnFood() {
  bool onSnake;
  do {
    onSnake = false;
    foodX = random(0, 9);
    foodY = random(0, 5);
    for(int i=0; i<snakeLen; i++) if(snakeX[i] == foodX && snakeY[i] == foodY) onSnake = true;
  } while(onSnake);
}

void resetSnake() {
  snakeLen = 3; snakeDir = 1; snakeAlive = true;
  snakeX[0]=4; snakeY[0]=2; snakeX[1]=3; snakeY[1]=2; snakeX[2]=2; snakeY[2]=2;
  spawnFood();
}

void loadText(String msg) {
  msg.toUpperCase(); totalCols = 0;
  for (int i = 0; i < 9; i++) textBuffer[totalCols++] = 0x00; 
  for (int i = 0; i < msg.length(); i++) {
    if (totalCols >= MAX_BUFFER - 15) break; 
    char c = msg[i]; int fontIndex = 36;
    if (c >= 'A' && c <= 'Z') fontIndex = c - 'A';
    else if (c >= '0' && c <= '9') fontIndex = c - '0' + 26;
    for (int col = 0; col < 3; col++) textBuffer[totalCols++] = font3x5[fontIndex][col];
    textBuffer[totalCols++] = 0x00; 
  }
  for (int i = 0; i < 9; i++) textBuffer[totalCols++] = 0x00;
  scrollIndex = 0;
}

// --- Web Handlers ---
void setupWeb() {
  server.on("/", []() { server.send(200, "text/html", htmlPage); });
  
  server.on("/msg", []() {
    if (server.hasArg("val")) { loadText(server.arg("val")); currentMode = MODE_SCROLL; }
    server.send(200);
  });
  
  server.on("/speed", []() {
    if (server.hasArg("val")) scrollSpeed = server.arg("val").toInt();
    server.send(200);
  });

  server.on("/time", []() {
    if (server.hasArg("val")) {
      String val = server.arg("val");
      if (val.length() >= 4) {
        tHour = val.substring(0, 2).toInt(); tMin = val.substring(2, 4).toInt();
        if (val.length() >= 6) tSec = val.substring(4, 6).toInt(); else tSec = 0;
      }
      lastTimeTick = millis(); currentMode = MODE_TIME;
    }
    server.send(200);
  });

  server.on("/snake", []() { resetSnake(); currentMode = MODE_SNAKE; server.send(200); });
  server.on("/dir", []() {
    if (server.hasArg("val")) {
      int newDir = server.arg("val").toInt();
      if (abs(newDir - snakeDir) != 2) snakeDir = newDir; 
    }
    server.send(200);
  });

  // New Animation Handler
  server.on("/anim", []() {
    if (server.hasArg("val")) {
      currentAnim = server.arg("val").toInt();
      animFrameIdx = 0;
      currentMode = MODE_ANIM;
      lastAnimTime = millis();
    }
    server.send(200);
  });
}

void setup() {
  pinMode(dataPin, OUTPUT); pinMode(latchPin, OUTPUT); pinMode(clockPin, OUTPUT); pinMode(col9Pin, OUTPUT);
  for (int i = 0; i < 5; i++) { pinMode(rowPins[i], OUTPUT); digitalWrite(rowPins[i], LOW); }
  WiFi.softAP(ssid, password);
  setupWeb(); server.begin();
  loadText("READY"); lastTimeTick = millis();
}

void loop() {
  server.handleClient();
  unsigned long now = millis();

  // RTC Engine
  if (now - lastTimeTick >= 1000) {
    lastTimeTick += 1000; tSec++;
    if (tSec >= 60) { tSec = 0; tMin++; if (tMin >= 60) { tMin = 0; tHour++; if (tHour >= 24) tHour = 0; } }
  }

  // MODE: ANIMATIONS
  if (currentMode == MODE_ANIM) {
    if (now - lastAnimTime >= currentAnimDelay) {
      lastAnimTime = now;

      // Draw the current frame
      for (int r = 0; r < 5; r++) {
        if (currentAnim == 0) frame[r] = animHeart[animFrameIdx][r]; // Heart
        else frame[r] = animFace[animFrameIdx][r];                   // Face
      }

      // Dynamic Timing logic (makes it look alive instead of robotic)
      if (currentAnim == 0) {
        // Heartbeat timing: Thump (long wait), Thump (short wait)
        currentAnimDelay = (animFrameIdx == 0) ? 700 : 150; 
      } else {
        // Face Blink timing: Eyes open for 3 seconds, closed for a quick 150ms blink
        currentAnimDelay = (animFrameIdx == 0) ? 3000 : 150; 
      }

      // Cycle to the next frame
      animFrameIdx++;
      if (animFrameIdx > 1) animFrameIdx = 0;
    }
  }

  // MODE: SCROLLING TEXT
  else if (currentMode == MODE_SCROLL) {
    if (now - lastScrollTime >= scrollSpeed) {
      lastScrollTime = now;
      for (int r = 0; r < 5; r++) {
        frame[r] = 0;
        for (int c = 0; c < 9; c++) {
          if (scrollIndex + c < totalCols) {
            if (textBuffer[scrollIndex + c] & (1 << r)) frame[r] |= (1 << c);
          }
        }
      }
      scrollIndex++; if (scrollIndex >= totalCols - 9) scrollIndex = 0;
    }
  }
  
  // MODE: STATIC TIME
  else if (currentMode == MODE_TIME) {
    bool showHour = ((now / 2000) % 2 == 0); 
    int digit1 = showHour ? (tHour / 10) : (tMin / 10);
    int digit2 = showHour ? (tHour % 10) : (tMin % 10);
    int idx1 = digit1 + 26; int idx2 = digit2 + 26;
    for (int r = 0; r < 5; r++) {
      frame[r] = 0;
      for(int c=0; c<3; c++) if (font3x5[idx1][c] & (1<<r)) frame[r] |= (1 << (c + 1));
      for(int c=0; c<3; c++) if (font3x5[idx2][c] & (1<<r)) frame[r] |= (1 << (c + 5));
    }
  }

  // MODE: SNAKE GAME
  else if (currentMode == MODE_SNAKE && snakeAlive) {
    if (now - lastSnakeTime >= snakeSpeed) {
      lastSnakeTime = now;
      for(int i = snakeLen-1; i > 0; i--) { snakeX[i] = snakeX[i-1]; snakeY[i] = snakeY[i-1]; }
      if (snakeDir == 0) snakeY[0]--; if (snakeDir == 1) snakeX[0]++;
      if (snakeDir == 2) snakeY[0]++; if (snakeDir == 3) snakeX[0]--;
      if (snakeX[0] < 0) snakeX[0] = 8; if (snakeX[0] > 8) snakeX[0] = 0;
      if (snakeY[0] < 0) snakeY[0] = 4; if (snakeY[0] > 4) snakeY[0] = 0;
      for(int i=1; i<snakeLen; i++) if(snakeX[0] == snakeX[i] && snakeY[0] == snakeY[i]) snakeAlive = false; 
      if (snakeX[0] == foodX && snakeY[0] == foodY) { if(snakeLen < 45) snakeLen++; spawnFood(); }
      for(int r=0; r<5; r++) frame[r] = 0;
      if ((now / 150) % 2 == 0) frame[foodY] |= (1 << foodX);
      if (snakeAlive) { for(int i=0; i<snakeLen; i++) frame[snakeY[i]] |= (1 << snakeX[i]); } 
      else { for(int r=0; r<5; r++) frame[r] = 0b111111111; loadText("DEAD"); currentMode = MODE_SCROLL; }
    }
  }

  // --- HIGH-SPEED MULTIPLEXER ---
  for (int row = 0; row < 5; row++) {
    for (int i = 0; i < 5; i++) digitalWrite(rowPins[i], LOW);
    byte shiftData = frame[row] & 0xFF; 
    bool col9Data = (frame[row] >> 8) & 1; 
    digitalWrite(col9Pin, col9Data ? HIGH : LOW);
    digitalWrite(latchPin, LOW); shiftOut(dataPin, clockPin, MSBFIRST, shiftData); digitalWrite(latchPin, HIGH);
    digitalWrite(rowPins[row], HIGH); delay(2); 
  }
}
