#include <WiFi.h>
#include <WebServer.h>

// --- Pin Definitions ---
const int dataPin  = 23; 
const int latchPin = 22; 
const int clockPin = 21; 
const int col9Pin  = 4;   
const int rowPins[5] = {19, 18, 5, 17, 16};

// --- Web Server Setup ---
const char* ssid = "ESP32_Matrix"; 
const char* password = "";         
WebServer server(80);

// --- Global Display Variables ---
uint16_t frame[5] = {0, 0, 0, 0, 0};
enum Mode { MODE_SCROLL, MODE_TIME, MODE_SNAKE, MODE_ANIM };
Mode currentMode = MODE_SCROLL;

// --- 1. Scrolling Text Variables ---
const int MAX_BUFFER = 2000; 
uint8_t textBuffer[MAX_BUFFER]; 
int totalCols = 0;
int scrollIndex = 0;
unsigned long lastScrollTime = 0;
int scrollSpeed = 120; 

// --- 2. Time Variables ---
int tHour = 12;
int tMin = 0;
int tSec = 0;
unsigned long lastTimeTick = 0;

// --- 3. Snake Game Variables ---
int snakeX[45], snakeY[45];
int snakeLen = 3;
int foodX, foodY;
int snakeDir = 1; 
unsigned long lastSnakeTime = 0;
const int snakeSpeed = 400; 
bool snakeAlive = false;

// --- 4. Animation Variables ---
int currentAnim = 0; // 0 = Heart, 1 = Face
int animFrameIdx = 0;
unsigned long lastAnimTime = 0;
int currentAnimDelay = 500;

// Frame 1: Big Heart, Frame 2: Small Heart
const uint16_t animHeart[2][5] = {
  { 0b001101100, 0b011111110, 0b001111100, 0b000111000, 0b000010000 },
  { 0b000000000, 0b000101000, 0b001111100, 0b000111000, 0b000010000 }
};

// Frame 1: Eyes Open, Frame 2: Eyes Closed (Blink)
const uint16_t animFace[2][5] = {
  { 0b011000110, 0b011000110, 0b000000000, 0b100000001, 0b011111110 },
  { 0b000000000, 0b011000110, 0b000000000, 0b100000001, 0b011111110 }
};

